# Copy to .env and fill in the values. Fake values only in this file.

# --- Required ---

# Env file location. The MCP client config sets it; defaults to .env in the working directory.
ENV_FILE_PATH=.env

# Absolute path to this repo's voice/ folder (rules and gates). Needed by Brown's slop gate.
# init.sh sets it to ./voice when unset.
UNDERDOC_HARNESS_PATH=/absolute/path/to/underdoc/voice

# OpenCode Go key. Needed by the writer, reviewer and judges (Brown).
OPENCODE_API_KEY=your-opencode-go-key

# --- Optional ---

# Opik observability. Needed only for tracing and evals.
OPIK_API_KEY=your-opik-key
OPIK_WORKSPACE=your-opik-workspace
